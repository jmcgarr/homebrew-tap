#!/usr/bin/env bash
# Bump one formula to a release tag.
#
#   bin/update-formula <formula> <tag>
#   bin/update-formula git-grab 0.6
#   bin/update-formula dirty v0.1.0
#
# Rewrites the release tag in every url and every sha256 in
# Formula/<formula>.rb from the release's SHA256SUMS asset, downloading
# individual assets to hash them when the release has no SHA256SUMS. Homebrew
# reads the version from the url, so there is no version line. Asset names
# come from the url lines themselves, so each tool may use its own naming. Runs brew style (and
# brew audit when run from the tapped checkout). Does not commit.
set -euo pipefail

if [ $# -ne 2 ]; then
  sed -n '2,12p' "$0" >&2
  exit 2
fi

formula=$1
tag=$2
here=$(cd "$(dirname "$0")/.." && pwd)
file="$here/Formula/$formula.rb"

[ -f "$file" ] || { echo "no such formula: $file" >&2; exit 1; }

repo=$(sed -n 's|^ *homepage "https://github.com/\([^"]*\)".*|\1|p' "$file")
[ -n "$repo" ] || { echo "cannot read GitHub repo from homepage line in $file" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

gh release view "$tag" -R "$repo" >/dev/null || { echo "no release $tag in $repo" >&2; exit 1; }
gh release download "$tag" -R "$repo" -p SHA256SUMS -D "$tmp" 2>/dev/null || true
touch "$tmp/SHA256SUMS"

# Swap the release tag in every url: .../releases/download/<old>/<asset>
sed -i.bak -E "s|(/releases/download/)[^/]+/|\1$tag/|" "$file" && rm -f "$file.bak"

# One "name sha" line per asset the formula references.
: > "$tmp/sums"
while IFS= read -r url; do
  name=$(basename "$url")
  sha=$(awk -v n="$name" '$2 == n { print $1 }' "$tmp/SHA256SUMS")
  if [ -z "$sha" ]; then
    echo "hashing $name (not in SHA256SUMS)" >&2
    curl -fsSL "$url" -o "$tmp/$name" || { echo "asset not found: $url" >&2; exit 1; }
    sha=$(shasum -a 256 "$tmp/$name" | cut -d' ' -f1)
  fi
  echo "$name $sha" >> "$tmp/sums"
done < <(sed -n 's/^ *url "\([^"]*\)".*/\1/p' "$file")

awk -v sums="$tmp/sums" '
  BEGIN { while ((getline line < sums) > 0) { split(line, f, " "); sha[f[1]] = f[2] } }
  /^ *url "/ {
    u = $0; sub(/^ *url "/, "", u); sub(/".*$/, "", u)
    n = split(u, parts, "/"); pending = parts[n]
  }
  /^ *sha256 "/ && pending != "" { sub(/"[^"]*"/, "\"" sha[pending] "\""); pending = "" }
  { print }
' "$file" > "$tmp/new.rb"

mv "$tmp/new.rb" "$file"
echo "updated $file to $tag"

brew style "$file"
# brew audit only accepts formula names, so it needs this checkout to be the
# tapped one (true in CI; locally only if you tapped this directory).
if [ "$(brew --repository jmcgarr/tap 2>/dev/null)" = "$here" ]; then
  brew audit --strict --online "jmcgarr/tap/$formula"
else
  echo "skipped brew audit: $here is not the tapped checkout" >&2
fi
